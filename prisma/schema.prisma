// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  avatarUrl String?
  firstName String
  lastName  String
  password  String
  role      String?
  position  String?
  location  String?
  phone     String?

  createdProjects  Project[]    @relation("userProjects")
  assignedProjects Project[]    @relation("assignedProjects")
  assignedTasks    Task[]       @relation("assignedTasks")
  tasksCreated     Task[]       @relation("tasksCreated")
  tasksUpdated     Task[]       @relation("tasksUpdated")
  comments         Comment[]
  attachments      Attachment[]
  refreshTokens    RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
model RefreshToken {
  id        String   @id @default(uuid())
  hashedToken String   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])   // for cron cleanup
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  archived    Boolean @default(false)
  favorite    Boolean @default(false)
  slug        String  @unique

  createdBy     User   @relation("userProjects", fields: [createdById], references: [id])
  createdById   String @map("created_by")
  members User[] @relation("assignedProjects")

  tasks Task[] @relation("projectToTasks")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  project   Project @relation("projectToTasks", fields: [projectId], references: [id])
  projectId String  @map("project_id")

  assignee   User?   @relation("assignedTasks", fields: [assigneeId], references: [id])
  assigneeId String? @map("assignee_id")

  status     Status  @relation("taskStatus", fields: [statusId], references: [id])
  statusId   String

  type       Status  @relation("taskType", fields: [typeId], references: [id])
  typeId     String

  priority   Status? @relation("taskPriority", fields: [priorityId], references: [id])
  priorityId String?

  estimation String?
  dueDate    DateTime? @map("due_date")

  createdBy   User   @relation("tasksCreated", fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  updatedBy   User   @relation("tasksUpdated", fields: [updatedById], references: [id])
  updatedById String @map("updated_by_id")

  comments    Comment[]    @relation("taskToComments")
  attachments Attachment[] @relation("taskToAttachments")

  relatedTo    Task?   @relation("taskRelations", fields: [relatedToId], references: [id])
  relatedToId  String? @map("related_to")

  relatedTasks Task[]  @relation("taskRelations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([statusId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([dueDate])
}

model Comment {
  id      String @id @default(uuid())
  content String

  parentId String?   @map("parent_id")
  replies  Comment[] @relation("commentToReplies")
  parent   Comment?  @relation("commentToReplies", fields: [parentId], references: [id])

  task   Task   @relation("taskToComments", fields: [taskId], references: [id])
  taskId String @map("task_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by")

  @@index([taskId])
  @@index([createdById])
  @@index([parentId])
}

model Attachment {
  id   String @id @default(uuid())
  name String
  url  String
  type String
  size Int

  task   Task   @relation("taskToAttachments", fields: [taskId], references: [id])
  taskId String @map("task_id")

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
}

model Status {
  id    String @id @default(uuid())
  label String
  color String
  type  String

  tasksWithPriority Task[] @relation("taskPriority")
  tasksWithStatus   Task[] @relation("taskStatus")
  tasksWithType     Task[] @relation("taskType")
}

