FROM node:20-alpine

WORKDIR /app

# Install dependencies first (better caching)
COPY package.json yarn.lock ./
RUN yarn install

# Copy the rest of your app
COPY . .

# Expose port
EXPOSE 3000

# For hot-reload to work reliably inside Docker (especially on Linux/macOS)
ENV CHOKIDAR_USEPOLLING=true \
    WATCHPACK_POLLING=true \
    NODE_ENV=development

# Start in watch mode
CMD ["yarn", "start:dev"]